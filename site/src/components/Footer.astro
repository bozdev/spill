---
import BozLogo from "./BozLogo.astro";
import { site } from "../nav";
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <a class="made-by" href={site.bozdev} title="bozdev.com">
      <span>Made by</span>
      <BozLogo />
    </a>
    <nav class="footer-links" aria-label="Elsewhere">
      <a href={site.github}>GitHub</a>
      <a href={site.npm}>npm</a>
      <a href={`${site.github}/blob/main/CHANGELOG.md`}>Changelog</a>
      <a href={`${site.github}/blob/main/LICENSE`}>MIT License</a>
      <a href="https://www.embla-carousel.com">Embla Carousel</a>
    </nav>
  </div>
</footer>
