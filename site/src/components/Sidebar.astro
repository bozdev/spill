---
import { nav } from "../nav";
const path = Astro.url.pathname;
---
<aside class="sidebar" id="sidebar" aria-label="Docs">
  {nav.map((group) => (
    <div class="sidebar-group">
      <p class="sidebar-title">{group.title}</p>
      <ul>
        {group.items.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.title}</a></li>
        ))}
      </ul>
    </div>
  ))}
</aside>
